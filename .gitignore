# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/doc

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
*.whl

# PyCharm / JetBrains
.idea/

# pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# mypy / type checkers
.mypy_cache/
.dmypy.json
.pytype/

# ruff / linters
.ruff_cache/

# archived tooling (kept locally, never pushed)
archive/

# docker
*.log

# OS
Thumbs.db
.claude/

#doc
/tests

.mcp.json

sa-key.json

# spec-pipeline
.spec-pipeline/

# local app logs (rotated by TimedRotatingFileHandler — *.log already covers
# the live file; this also drops the date-suffixed historical rotations)
/logs/

# Scripts
/scripts
/roadmap

# local database volume artefacts
/pgdata/

# Certificates for a build behind an intercepting proxy are local, never committed.
ca/*.crt
ca/*.pem

# Issued team tokens and the SQL that activates them (M12 task 3.6). The SQL
# names a client and a jti, and the token file is the credential itself; both
# are handed over through a secure channel, never through this repository.
db/scripts/issued/
*.jwt
